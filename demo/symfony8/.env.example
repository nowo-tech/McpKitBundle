# APP_ENV: Symfony environment (dev/test/prod). In demos it is usually `dev`.
APP_ENV=dev

# APP_DEBUG: Enable/disable detailed debug output (usually `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: Secret used for signing/tokens. Use a local-only value in demos.
APP_SECRET=CHANGE_ME_LOCAL_SECRET

# APP_VERSION: Version string reported as serverInfo.version by the MCP endpoint.
APP_VERSION=demo-1.0.0

# PORT: Host port mapped to HTTP :80 inside the FrankenPHP container (symfony8 demo default: 8219).
PORT=8219

# DEFAULT_URI: Base URL for generating URLs in CLI (must match PORT for local HTTP checks).
DEFAULT_URI=http://localhost:8219

# MCP_CONFORMANCE: 1 turns on the demo-only conformance profile (anonymous caller + the runner's fixture tools).
# Never in a real application.
MCP_CONFORMANCE=0
